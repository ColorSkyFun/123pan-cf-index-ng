{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "that-sky-project-achive",
	"workers_dev": true,
	"preview_urls": false,
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "PAN_INDEX_KV",
			"id": "b3d5cba1784b4385864fc3614fcc5d4c"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "that-sky-project-achive"
		}
	]
}